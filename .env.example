# Copy to .env and adjust if needed.
# Local development database is started with `npm run db:start` (PostgreSQL 5433).
DATABASE_URL="postgresql://roomcraft:roomcraft@127.0.0.1:5433/roomcraft?schema=public"

# API
PORT=4000
NODE_ENV=development
JWT_SECRET="dev-only-change-me-please-0123456789abcdef"
SESSION_COOKIE_NAME="roomcraft_session"
# Alleen voor lokale HTTP-deploys (bijv. de Windows-installer): zet op false.
# Weggelaten of true betekent: Secure-cookie, dus HTTPS-only in productie.
COOKIE_SECURE=""
# Origin of the Vite dev server, used for CORS in development.
CLIENT_ORIGIN="http://localhost:5173"

# Dutch retailer connectors — intentionally empty until a feed/API agreement exists.
# Each adapter stays disabled and reports `not_configured` while these are unset.
IKEA_NL_FEED_URL=""
IKEA_NL_API_KEY=""
BOL_FEED_URL=""
BOL_API_KEY=""
LEENBAKKER_FEED_URL=""
LEENBAKKER_API_KEY=""
KWANTUM_FEED_URL=""
KWANTUM_API_KEY=""
PRAXIS_FEED_URL=""
PRAXIS_API_KEY=""
GOOSSENS_FEED_URL=""
GOOSSENS_API_KEY=""
FONQ_FEED_URL=""
FONQ_API_KEY=""
WEHKAMP_FEED_URL=""
WEHKAMP_API_KEY=""
HEMA_FEED_URL=""
HEMA_API_KEY=""
BLOKKER_FEED_URL=""
BLOKKER_API_KEY=""
SEATS_EN_SOFAS_FEED_URL=""
SEATS_EN_SOFAS_API_KEY=""
PRONTO_WONEN_FEED_URL=""
PRONTO_WONEN_API_KEY=""
